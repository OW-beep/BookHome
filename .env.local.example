# サイトマップ・robots.txt生成に使用。あなたのVercel本番URLを入れてください（末尾のスラッシュなし）
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# 任意：Google Analytics 4 の測定ID（未設定でも動作します。アクセス解析が不要ならこのままでOK）
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# SupabaseプロジェクトのSettings > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 任意：楽天アフィリエイトの審査が通ったら設定してください（未設定でも購入リンクは動作します）
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=

# 任意：楽天ウェブサービス（無料・即時発行）のアプリID。設定すると「今売れている本」に
# 実際のランキングデータが表示されます（未設定時は定番本のリストにフォールバックします）
# 2026年5月の楽天API仕様変更により、アプリケーションIDとアクセスキーの両方が必要です
# https://webservice.rakuten.co.jp/ から取得
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
