# サイトマップ・robots.txt生成に使用。あなたのVercel本番URLを入れてください（末尾のスラッシュなし）
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# SupabaseプロジェクトのSettings > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 任意：楽天アフィリエイトの審査が通ったら設定してください（未設定でも購入リンクは動作します）
NEXT_PUBLIC_RAKUTEN_AFFILIATE_ID=

# 任意：Amazonアソシエイトのトラッキングid（例: yourtag-22）。Amazonアソシエイト・セントラルの
# 「アカウント情報」やリンク作成画面で確認できます。未設定でも検索リンクとしては動作しますが、
# 成果報酬は発生しません。
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# 任意：Google Analytics 4のGA4測定ID（G-XXXXXXXXXX形式）。GA4管理画面の
# 「データストリーム」から取得してください。未設定の場合はGA4のスクリプトは読み込まれません。
# （Vercel Analyticsはこの設定と無関係に、Vercelにデプロイするだけで自動計測されます）
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 任意：楽天ウェブサービス（無料・即時発行）のアプリID。設定すると「今売れている本」に
# 実際のランキングデータが表示されます（未設定時は定番本のリストにフォールバックします）
# 2026年5月の楽天API仕様変更により、アプリケーションIDとアクセスキーの両方が必要です
# https://webservice.rakuten.co.jp/ から取得
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
